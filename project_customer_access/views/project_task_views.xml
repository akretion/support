<odoo>

    <menuitem
        id="menu_project_customer_root"
        name="Customer Project"
        web_icon="project_customer_access,static/description/icon.svg"
        groups="project_customer_access.group_customer"
        sequence="1"
    />

    <record id="view_task_search_form" model="ir.ui.view">
        <field name="name">project.task.search.form (in project_customer_access)</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search string="Tasks">
                <field
                    name="name"
                    string="Task"
                    filter_domain="['|', ('name', 'ilike', self), ('id', 'ilike', self)]"
                />
                <field name="tag_ids" />
                <field
                    name="user_ids"
                    string="External Assignees"
                    filter_domain="[('user_ids.name', 'ilike', self), ('user_ids.active', 'in', [True, False])]"
                />
                <field
                    name="customer_user_ids"
                    string="Internal Assignees"
                    filter_domain="[('customer_user_ids.name', 'ilike', self), ('customer_user_ids.active', 'in', [True, False])]"
                />
                <field name="stage_id" />
                <field name="partner_id" operator="child_of" />
                <field name="description" />
                <filter
                    string="My Tasks"
                    name="my_tasks"
                    domain="[('customer_user_ids', 'in', uid)]"
                />
                <filter
                    string="Followed Tasks"
                    name="followed_by_me"
                    domain="[('message_is_follower', '=', True)]"
                />
                <filter
                    string="Unassigned (internal)"
                    name="unassigned"
                    domain="[('customer_user_ids', '=', False)]"
                />
                <filter
                    string="Unassigned (external)"
                    name="unassigned"
                    domain="[('user_ids', '=', False)]"
                />
                <separator />
                <filter
                    name="current_sprint_level_1"
                    string="Current Sprint By Year"
                    domain="[('sprint_level_1_id.date_start', '&lt;=', datetime.datetime.now()), ('sprint_level_1_id.date_end', '&gt;=', datetime.datetime.now())]"
                />
                <filter
                    name="current_sprint_level_2"
                    string="Current Sprint By Quarter"
                    domain="[('sprint_level_2_id.date_start', '&lt;=', datetime.datetime.now()), ('sprint_level_2_id.date_end', '&gt;=', datetime.datetime.now())]"
                />
                <filter
                    name="current_sprint_level_3"
                    string="Current Sprint By Month"
                    domain="[('sprint_level_3_id.date_start', '&lt;=', datetime.datetime.now()), ('sprint_level_3_id.date_end', '&gt;=', datetime.datetime.now())]"
                />
                <filter
                    name="current_sprint_level_4"
                    string="Current Sprint By Fortnight"
                    domain="[('sprint_level_4_id.date_start', '&lt;=', datetime.datetime.now()), ('sprint_level_4_id.date_end', '&gt;=', datetime.datetime.now())]"
                />
                <separator />
                <filter
                    string="High Priority"
                    name="high_priority"
                    domain="[('priority', '=', 1)]"
                />
                <filter
                    string="Low Priority"
                    name="low_priority"
                    domain="[('priority', '=', 0)]"
                />
                <separator />
                <filter
                    string="Late Tasks"
                    name="late"
                    domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('is_closed', '=', False)]"
                />
                <filter
                    string="Tasks Due Today"
                    name="tasks_due_today"
                    domain="[('date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    string="Stalling for 30 Days+"
                    name="stall_last_30_days"
                    domain="[('is_closed', '=', False), ('date_last_stage_update', '&lt;=', datetime.datetime.now() - relativedelta(days=30))]"
                />
                <separator />
                <filter
                    string="Open Tasks"
                    name="open_tasks"
                    domain="[('is_closed', '=', False)]"
                />
                <filter
                    string="Closed Tasks"
                    name="closed_tasks"
                    domain="[('is_closed', '=', True)]"
                />
                <filter
                    string="Closed Last 7 Days"
                    name="closed_last_7_days"
                    domain="[('is_closed', '=', True), ('date_last_stage_update', '&gt;', datetime.datetime.now() - relativedelta(days=7))]"
                />
                <filter
                    string="Closed Last 30 Days"
                    name="closed_last_30_days"
                    domain="[('is_closed', '=', True), ('date_last_stage_update', '&gt;', datetime.datetime.now() - relativedelta(days=30))]"
                />
                <separator />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        string="Stage"
                        name="stage"
                        context="{'group_by': 'stage_id'}"
                    />
                    <filter
                        string="External Assignees"
                        name="user"
                        context="{'group_by': 'user_ids'}"
                    />
                    <filter
                        string="Internal Assignees"
                        name="user_customer"
                        context="{'group_by': 'customer_user_ids'}"
                    />
                    <filter
                        string="Customer"
                        name="customer"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        string="Kanban State"
                        name="kanban_state"
                        context="{'group_by': 'kanban_state'}"
                    />
                    <filter
                        string="Deadline"
                        name="date_deadline"
                        context="{'group_by': 'date_deadline'}"
                    />
                    <filter
                        string="Creation Date"
                        name="group_create_date"
                        context="{'group_by': 'create_date'}"
                    />
                    <separator />
                    <filter
                        name="group_sprint_level_1"
                        string="Sprint By Year"
                        context="{'group_by': 'sprint_level_1_id'}"
                    />
                    <filter
                        name="group_sprint_level_2"
                        string="Sprint By Quarter"
                        context="{'group_by': 'sprint_level_2_id'}"
                    />
                    <filter
                        name="group_sprint_level_3"
                        string="Sprint By Month"
                        context="{'group_by': 'sprint_level_3_id'}"
                    />
                    <filter
                        name="group_sprint_level_4"
                        string="Sprint By Fortnight"
                        context="{'group_by': 'sprint_level_4_id'}"
                    />
                    <separator />
                    <filter
                        name="is_urgent"
                        string="Urgent Tasks"
                        domain="[('is_urgent', '=', True)]"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_task_form" model="ir.ui.view">
        <field name="name">project.task.form (in project_customer_access)</field>
        <field name="model">project.task</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <form
                string="Task"
                class="o_form_project_tasks"
                js_class="project_task_form"
            >
                <field name="is_closed" invisible="1" />
                <field name="parent_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <header>
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable': '1', 'fold_field': 'fold'}"
                        attrs="{'invisible': [('project_id', '=', False), ('stage_id', '=', False)]}"
                    />
                </header>
                <div
                    class="alert alert-danger"
                    role="alert"
                    style="margin-bottom:0px;"
                    attrs="{'invisible': [('is_urgent','=',False)]}"
                >
                    <p>
                        <strong>This task has been marked as urgent.</strong>
                        <br /> All other tasks
                        will be put on hold until this task is completed in order to treat it with
                        the highest priority. This will have an impact on the treatment delay of the
                        other tasks. </p>
                </div>
                <sheet string="Task">
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                        <div class="oe_title pe-0" style="max-width: 100%; width: 100%;">
    <h1 class="d-flex align-items-center w-100">
        <field name="priority" widget="priority" class="me-3"/>

        <div class="d-flex align-items-center flex-grow-1">
            <span class="text-nowrap">N: </span>
            <field name="id" class="ms-1 me-2" modifiers='{"readonly": true}'/>
            <span class="me-2">-</span>
            <field name="name" placeholder="Titre de la tâche..." default_focus="1" class="flex-grow-1" modifiers='{"required": true, "readonly": false}'/>
        </div>

        <field name="kanban_state" widget="state_selection" class="ms-2" modifiers='{"required": true, "readonly": true}' invisible="1"/>
    </h1>
</div>
                    <group>
                        <group>
                            <field
                                name="project_id"
                                domain="[('active', '=', True), ('company_id', '=', company_id)]"
                                attrs="{'invisible': [('parent_id', '!=', False)]}"
                                required="1"
                                options="{'no_open': True, 'no_create': True}"
                            />
                            <field
                                name="display_project_id"
                                string="Project"
                                attrs="{'invisible': [('parent_id', '=', False)]}"
                                domain="[('active', '=', True), ('company_id', '=', company_id)]"
                                options="{'no_open': True, 'no_create': True}"
                            />
                            <field name="cross_connect_client_id" invisible="1"/>
                            <field
                                name="customer_user_ids"
                                string="Internal Assignees"
                                class="o_task_user_field"
                                options="{'no_open': True, 'no_quick_create': True}"
                                widget="many2many_avatar_user"
                            />
                            <field
                                name="user_ids"
                                string="External assignees"
                                class="o_task_user_field"
                                options="{'no_open': True, 'no_quick_create': True}"
                                widget="many2many_avatar_user"
                                domain="[('share', '=', False), ('active', '=', True), '|', ('cross_connect_client_id', '=', False), ('cross_connect_client_id', '=', cross_connect_client_id)]"
                                readonly="1"
                            />
                            <field name="use_sprint" invisible="1" />
                            <field
                                name="sprint_id"
                                attrs="{'invisible': [('use_sprint', '=', False)]}"
                                options="{'no_open': True, 'no_create': True}"
                            />
                        </group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="create_uid" widget="many2one_avatar_user" />
                            <field name="create_date" />
                            <field
                                    name="origin_url"
                                    readonly="1"
                                    force_save="1"
                                    widget="url"
                                    string="URL"
                                    attrs="{'invisible': [('origin_url', '=', False)]}"
                                />

                            <field name="estimate_step_id" readonly="1" />
                            <field
                                name="date_deadline"
                                attrs="{'invisible': [('is_closed', '=', True)]}"
                                readonly="1"
                            />
                            <field
                                name="is_urgent"
                                widget="boolean_toggle"
                                attrs="{'readonly': [('is_closed','=',True)]}"
                            />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                domain="['|', (not project_id and 1 or 0, '=', 1), ('project_ids', 'in', project_id)]"
                                options="{'color_field': 'color', 'no_create_edit': True}"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page name="description_page" string="Description">
                            <field
                                name="description"
                                type="html"
                                options="{'collaborative': true, 'resizable': false}"
                                placeholder="Task description..."
                            />
                        </page>
                        <page name="origin_page" string="Origin">
                            <group>
                                <field
                                    name="origin_url"
                                    readonly="1"
                                    force_save="1"
                                    widget="url"
                                    string="URL"
                                />
                                <field
                                    name="origin_db"
                                    readonly="1"
                                    force_save="1"
                                    string="DataBase"
                                />
                                <field
                                    name="origin_name"
                                    readonly="1"
                                    force_save="1"
                                    string="Record name"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field
                        name="message_follower_ids"
                        options="{'post_refresh':True}"
                    />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_task_kanban" model="ir.ui.view">
        <field name="name">project.task.kanban (in project_customer_access)</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="stage_id"
                class="o_kanban_small_column o_kanban_project_tasks"
                examples="project"
                js_class="project_task_kanban"
                sample="1"
            >
                <field name="color" />
                <field name="id" />
                <field name="priority" />
                <field name="is_urgent" />
                <field
                    name="stage_id"
                    options='{"group_by_tooltip": {"description": "Description"}}'
                />
                <field name="partner_id" />
                <field name="sequence" />
                <field name="is_closed" />
                <field name="partner_is_company" />
                <field name="displayed_image_id" />
                <field name="active" />
                <field name="legend_blocked" />
                <field name="legend_normal" />
                <field name="legend_done" />
                <progressbar
                    field="kanban_state"
                    colors='{"done": "success", "blocked": "danger", "normal": "200"}'
                />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_card oe_kanban_global_click"
                            t-attf-style="{{record.is_urgent.raw_value ? 'background-color: #f8d7da !important; border-color: #f5c2c7 !important' : ''}}"
                        >
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <s t-if="!record.active.raw_value">
                                                <field name="id" /><br />
                                                <field
                                                    name="name"
                                                    widget="name_with_subtask_count"
                                                />
                                            </s>
                                            <t t-else="">
                                                <field name="id" /><br />
                                                <field
                                                    name="name"
                                                    widget="name_with_subtask_count"
                                                />
                                            </t>
                                        </strong>
                                        <span
                                            invisible="context.get('default_project_id', False)"
                                        >
                                            <br />
                                            <field
                                                name="project_id"
                                                options="{'no_open': True}"
                                            />
                                        </span>
                                        <br />
                                        <small><field name="create_date" widget="date" /></small>
                                    </div>
                                    <div
                                        class="o_dropdown_kanban dropdown"
                                        t-if="!selection_mode"
                                        groups="base.group_user"
                                    >
                                        <a
                                            role="button"
                                            class="dropdown-toggle o-no-caret btn"
                                            data-bs-toggle="dropdown"
                                            data-bs-display="static"
                                            href="#"
                                            aria-label="Dropdown menu"
                                            title="Dropdown menu"
                                        >
                                            <span class="fa fa-ellipsis-v" />
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a
                                                t-if="widget.editable"
                                                role="menuitem"
                                                type="edit"
                                                class="dropdown-item"
                                            >Edit</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field
                                        name="tag_ids"
                                        widget="many2many_tags"
                                        options="{'color_field': 'color'}"
                                    />
                                    <div
                                        t-if="record.date_deadline.raw_value"
                                        name="date_deadline"
                                        attrs="{'invisible': [('is_closed', '=', True)]}"
                                    >
                                        <field
                                            name="date_deadline"
                                            widget="remaining_days"
                                        />
                                    </div>
                                    <div t-if="record.displayed_image_id.value">
                                        <field
                                            name="displayed_image_id"
                                            widget="attachment_image"
                                        />
                                    </div>
                                </div>
                                <div
                                    class="o_kanban_record_bottom"
                                    t-if="!selection_mode"
                                >
                                    <div class="oe_kanban_bottom_left">
                                        <field
                                            name="priority"
                                            widget="priority"
                                        />
                                    </div>
                                    <div
                                        class="oe_kanban_bottom_right"
                                        t-if="!selection_mode"
                                    >
                                        <field
                                            name="kanban_state"
                                            widget="state_selection"
                                            groups="base.group_user"
                                            readonly="1"
                                        />
                                        <t t-if="record.user_ids.raw_value">
                                            <field
                                                name="user_ids"
                                                widget="many2many_avatar_user"
                                            />
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="clearfix" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_task_tree" model="ir.ui.view">
        <field name="name">project.task.tree (in project_customer_access)</field>
        <field name="model">project.task</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <tree
                string="Tasks"
                multi_edit="1"
                sample="1"
                js_class="project_task_list"
                decoration-danger="is_urgent"
            >
                <field name="is_closed" invisible="1" />
                <field name="is_urgent" widget="boolean_toggle" />
                <field name="priority" widget="priority" optional="show" nolabel="1" />
                <field name="id" optional="show" />
                <field name="name" widget="name_with_subtask_count" />
                <field
                    name="project_id"
                    optional="show"
                    readonly="1"
                    options="{'no_open': 1}"
                />
                <field name="use_sprint" invisible="1" />
                <field
                    name="sprint_id"
                    attrs="{'invisible': [('use_sprint', '=', False)]}"
                />
                <field name="partner_id" optional="hide" />
                <field
                    name="user_ids"
                    optional="show"
                    widget="many2many_avatar_user"
                    domain="[('share', '=', False), ('active', '=', True)]"
                    options='{"no_quick_create": True}'
                />
                <field name="company_id" invisible="1" />
                <field
                    name="date_deadline"
                    optional="hide"
                    widget="remaining_days"
                    attrs="{'invisible': [('is_closed', '=', True)]}"
                />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                    context="{'project_id': project_id}"
                />
                <field name="legend_normal" invisible="1" />
                <field name="legend_done" invisible="1" />
                <field name="legend_blocked" invisible="1" />
                <field
                    name="kanban_state"
                    widget="state_selection"
                    optional="show"
                    options="{'hide_label': True}"
                    nolabel="1"
                    required="0"
                />
                <field
                    name="stage_id"
                    invisible="context.get('set_visible',False)"
                    optional="show"
                    readonly="not context.get('default_project_id')"
                />
                <field name="urgency_start_date" optional="hide" />
                <field name="urgency_end_date" optional="hide" />
                <field name="urgency_duration" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="action_view_all_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_open_tasks': 1, 'default_user_ids': []}</field>
        <field name="search_view_id" ref="view_task_search_form" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks found. Let's create one!
            </p>
            <p> Keep track of the progress of your tasks from creation to completion.<br
                />
                Collaborate efficiently by chatting in real-time or via email. </p>
        </field>
    </record>

    <record id="open_view_all_task_list_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="10" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_task_kanban" />
        <field name="act_window_id" ref="action_view_all_task" />
    </record>
    <record id="open_view_all_task_list_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="20" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_task_tree" />
        <field name="act_window_id" ref="action_view_all_task" />
    </record>
    <record id="open_view_all_task_list_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="30" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_task_form" />
        <field name="act_window_id" ref="action_view_all_task" />
    </record>


    <menuitem
        name="Tasks"
        id="menu_my_tasks"
        parent="menu_project_customer_root"
        action="action_view_all_task"
        groups="project_customer_access.group_customer"
        sequence="1"
    />

    <menuitem
        name="Budget"
        id="menu_project_customer_budget"
        parent="menu_project_customer_root"
        sequence="20"
        action="project_budget_subcontractor.project_budget_action"
        groups="project_customer_access.group_budget"
    />


    <record id="edit_project" model="ir.ui.view">
        <field name="name">project.project.form in project_customer_access</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']/.." position="after">
                <field name="cross_connect_client_id" />
                <field name="is_default_support_project" attrs="{'invisible': [('cross_connect_client_id', '=', False)]}" />
            </xpath>
        </field>
    </record>

    <!-- TODO: to remove if cross_connect_client_id already put by other module -->
    <record id="user_from_view" model="ir.ui.view">
        <field name="name">res.users.form in project_customer_access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']/.." position="inside">
                <label for="cross_connect_client_id" />
                <field name="cross_connect_client_id" />
            </xpath>
        </field>
    </record>

    <record id="view_task_form2" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="cross_connect_client_id" invisible="1"/>
                <field name="customer_user_ids"
                    string="External Assignees"
                    class="o_task_user_field"
                    options="{'no_open': True, 'no_quick_create': True}"
                    widget="many2many_avatar_user"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="domain">[('share', '=', False), ('active', '=', True), '|', ('cross_connect_client_id', '=', False), ('cross_connect_client_id', '=', cross_connect_client_id)]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
