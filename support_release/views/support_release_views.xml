<odoo>
    <record id="support_release_view_list" model="ir.ui.view">
        <field name="model">support.release</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="version" />
                <field name="tickets" />
                <field name="is_sent" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="support_release_view_form" model="ir.ui.view">
        <field name="model">support.release</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="version" />
                        <field name="is_sent" />
                        <field name="tickets" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="support_release_view_search" model="ir.ui.view">
        <field name="model">support.release</field>
        <field name="arch" type="xml">
            <search>
                <field name="version" />
                <filter
                    name="to_send"
                    string="To send"
                    domain="[('is_sent', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="support_release_action" model="ir.actions.act_window">
        <field name="name">Releases</field>
        <field name="res_model">support.release</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_send': 1}</field>
    </record>

    <menuitem
        id="support_release_menu"
        parent="base.menu_administration"
        action="support_release_action"
        groups="base.group_system"
        sequence="100"
    />
</odoo>
