<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.support.release</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="Support Releases"
                    string="Support Releases"
                    name="support_server_release"
                    data-key="support_server_release"
                    groups="base.group_system"
                >
                    <div
                        class="app_settings_block"
                        data-string="Support Releases"
                        string="Support Releases"
                        data-key="support_server_release"
                        groups="base.group_system"
                    >
                        <block title="Ticket stages" id="release_stages">
                            <div
                                class="row mt16 o_settings_container"
                                id="release_stages_container"
                            >
                                <div
                                    class="col-12 col-lg-6 o_setting_box"
                                    id="release_stage_preprod"
                                >
                                    <div class="o_setting_right_pane">
                                        <label
                                            for="support_server_release_stage_preprod_id"
                                        />
                                        <div class="text-muted">
                                            Stage applied to the tickets when a
                                            release is received from preprod
                                        </div>
                                        <div class="content-group">
                                            <field
                                                name="support_server_release_stage_preprod_id"
                                                class="o_light_label"
                                            />
                                        </div>
                                    </div>
                                </div>
                                <div
                                    class="col-12 col-lg-6 o_setting_box"
                                    id="release_stage_prod"
                                >
                                    <div class="o_setting_right_pane">
                                        <label
                                            for="support_server_release_stage_prod_id"
                                        />
                                        <div class="text-muted">
                                            Stage applied to the tickets when a
                                            release is received from prod
                                        </div>
                                        <div class="content-group">
                                            <field
                                                name="support_server_release_stage_prod_id"
                                                class="o_light_label"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </block>
                    </div>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
