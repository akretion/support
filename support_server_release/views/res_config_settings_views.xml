<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.project.support.release</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='tasks_management']" position="after">
                <block title="Support Releases" id="release_stages">
                    <setting
                        id="release_stage_preprod"
                        string="Preprod stage"
                        help="Stage applied to the tickets when a release is received from preprod."
                    >
                        <field name="support_server_release_stage_preprod_id" />
                    </setting>
                    <setting
                        id="release_stage_prod"
                        string="Prod stage"
                        help="Stage applied to the tickets when a release is received from prod."
                    >
                        <field name="support_server_release_stage_prod_id" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
