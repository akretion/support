<odoo>
    <record id="support_server_release_view_list" model="ir.ui.view">
        <field name="model">support.server.release</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="message">
                <field name="version" />
                <field name="cross_connect_client_id" />
                <field name="partner_id" />
                <field name="preprod_deployed_at" optional="show" />
                <field name="prod_deployed_at" optional="show" />
                <field name="message" optional="hide" />
            </list>
        </field>
    </record>

    <record id="support_server_release_view_form" model="ir.ui.view">
        <field name="model">support.server.release</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_tasks"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-tasks"
                            invisible="not task_count"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="task_count" />
                                </span>
                                <span class="o_stat_text">Tickets</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="version" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="cross_connect_client_id" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="preprod_deployed_at" />
                            <field name="prod_deployed_at" />
                        </group>
                    </group>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not message"
                        groups="!project_customer_access.group_customer"
                    >
                        <field name="message" />
                    </div>
                    <notebook>
                        <page string="Tickets" name="tickets">
                            <field name="task_ids">
                                <list>
                                    <field name="name" />
                                    <field name="project_id" />
                                    <field name="stage_id" />
                                    <field
                                        name="user_ids"
                                        widget="many2many_avatar_user"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="support_server_release_view_search" model="ir.ui.view">
        <field name="model">support.server.release</field>
        <field name="arch" type="xml">
            <search>
                <field name="version" />
                <field name="cross_connect_client_id" />
                <field name="partner_id" />
                <field name="task_ids" string="Ticket" />
                <filter name="next" string="Next" domain="[('version', '=', 'next')]" />
                <filter
                    name="prod"
                    string="In prod"
                    domain="[('prod_deployed_at', '!=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_client"
                        string="Client"
                        context="{'group_by': 'cross_connect_client_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="support_server_release_action" model="ir.actions.act_window">
        <field name="name">Releases</field>
        <field name="res_model">support.server.release</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="support_server_release_menu"
        name="Releases"
        parent="project.menu_main_pm"
        action="support_server_release_action"
        sequence="100"
    />

    <menuitem
        id="support_server_release_menu_customer"
        name="Releases"
        parent="project_customer_access.menu_project_customer_root"
        action="support_server_release_action"
        groups="project_customer_access.group_customer"
        sequence="15"
    />
</odoo>
