<odoo>
    <record id="view_task_form_releases" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_releases"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tags"
                    invisible="not release_ids"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            <field name="latest_release_version" />
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//page[@name='description_page']" position="after">
                <page
                    name="release_note"
                    string="Release note"
                    invisible="not use_release_note"
                >
                    <field name="use_release_note" invisible="1" />
                    <field
                        name="release_note"
                        placeholder="What changes for the customer once in production..."
                    />
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_task_search_form_release" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <filter name="stage" position="after">
                <filter
                    name="release"
                    string="Release"
                    context="{'group_by': 'release_ids'}"
                />
            </filter>
        </field>
    </record>
    <record id="view_task_search_form_customer_release" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_customer_access.view_task_search_form" />
        <field name="arch" type="xml">
            <filter name="stage" position="after">
                <filter
                    name="release"
                    string="Release"
                    context="{'group_by': 'release_ids'}"
                />
            </filter>
        </field>
    </record>
    <record id="view_task_form_customer_release" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_customer_access.view_task_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button
                        name="action_open_releases"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tags"
                        invisible="not release_ids"
                    >
                        <div class="o_stat_info">
                            <span class="o_stat_text">
                                <field name="latest_release_version" />
                            </span>
                        </div>
                    </button>
                </div>
            </xpath>
            <xpath expr="//page[@name='description_page']" position="after">
                <page
                    name="release_note"
                    string="Release note"
                    invisible="not use_release_note or not release_note"
                >
                    <field name="use_release_note" invisible="1" />
                    <field name="release_note" readonly="1" />
                </page>
            </xpath>
        </field>
    </record>
    <record id="edit_project_release_note" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <group name="extra_settings" position="inside">
                <field name="use_release_note" />
            </group>
        </field>
    </record>
</odoo>
