<odoo>
    <record id="view_task_form_releases" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_releases"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tags"
                    invisible="not release_ids"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Releases</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
