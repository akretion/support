<odoo>
    <record id="view_partner_form_release_notification" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="inside">
                <group string="Release notifications" name="release_notification">
                    <field
                        name="support_release_notification_user_ids"
                        widget="many2many_tags"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
