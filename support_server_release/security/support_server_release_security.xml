<odoo>
    <record id="rule_release_customer" model="ir.rule">
        <field name="name">Support Server Release: releases of the client</field>
        <field name="model_id" ref="model_support_server_release" />
        <field name="domain_force">
            [("cross_connect_client_id", "=", user.cross_connect_client_id.id)]
        </field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
        <field
            name="groups"
            eval="[(4, ref('project_customer_access.group_customer'))]"
        />
    </record>
</odoo>
