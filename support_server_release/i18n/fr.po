#. module: support_server_release
#: model:mail.template,body_html:support_server_release.mail_template_release_in_prod
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    Version\n"
"                    <strong t-out=\"object.version\"/>\n"
"                    of\n"
"                    <strong t-out=\"object.cross_connect_client_id.name\"/>\n"
"                    is now deployed in production. It contains the following\n"
"                    tickets:\n"
"                </p>\n"
"                <t t-set=\"tasks\" t-value=\"object._get_notified_tasks()\"/>\n"
"                <div t-foreach=\"tasks.project_id\" t-as=\"project\">\n"
"                    <h4 t-out=\"project.name\" style=\"margin:18px 0 4px 0;font-size:14px;\"/>\n"
"                    <ul>\n"
"                        <li t-foreach=\"tasks\" t-as=\"task\" t-if=\"task.project_id == project\" style=\"margin-bottom:10px;\">\n"
"                            <a t-att-href=\"object._get_task_url(task)\" t-out=\"'[%s] %s' % (task.id, task.name)\"/>\n"
"                            <div t-if=\"task.use_release_note and not is_html_empty(task.release_note)\" t-out=\"task.release_note\" style=\"margin-top:4px;\"/>\n"
"                        </li>\n"
"                    </ul>\n"
"                </div>\n"
"                <p>Regards,</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;\">\n"
"                <p>Bonjour,</p>\n"
"                <p>\n"
"                    La version\n"
"                    <strong t-out=\"object.version\"/>\n"
"                    de\n"
"                    <strong t-out=\"object.cross_connect_client_id.name\"/>\n"
"                    est désormais déployée en production. Elle contient les\n"
"                    tickets suivants :\n"
"                </p>\n"
"                <t t-set=\"tasks\" t-value=\"object._get_notified_tasks()\"/>\n"
"                <div t-foreach=\"tasks.project_id\" t-as=\"project\">\n"
"                    <h4 t-out=\"project.name\" style=\"margin:18px 0 4px 0;font-size:14px;\"/>\n"
"                    <ul>\n"
"                        <li t-foreach=\"tasks\" t-as=\"task\" t-if=\"task.project_id == project\" style=\"margin-bottom:10px;\">\n"
"                            <a t-att-href=\"object._get_task_url(task)\" t-out=\"'[%s] %s' % (task.id, task.name)\"/>\n"
"                            <div t-if=\"task.use_release_note and not is_html_empty(task.release_note)\" t-out=\"task.release_note\" style=\"margin-top:4px;\"/>\n"
"                        </li>\n"
"                    </ul>\n"
"                </div>\n"
"                <p>Cordialement,</p>\n"
"            </div>\n"
"        "

