#. module: support_server_release
#: model:mail.template,body_html:support_server_release.mail_template_release_in_prod
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    Version\n"
"                    <strong t-out=\"object.version\"/>\n"
"                    of\n"
"                    <strong t-out=\"object.cross_connect_client_id.name\"/>\n"
"                    is now deployed in production. It contains the following\n"
"                    tickets:\n"
"                </p>\n"
"                <ul>\n"
"                    <li t-foreach=\"object.task_ids\" t-as=\"task\" style=\"margin-bottom:10px;\">\n"
"                        <a t-att-href=\"object._get_task_url(task)\" t-out=\"task.name\"/>\n"
"                        <div t-if=\"task.description\">\n"
"                            <details>\n"
"                                <summary style=\"cursor:pointer;color:#666;\">\n"
"                                    Description\n"
"                                </summary>\n"
"                                <div t-out=\"task.description\" style=\"border-left:3px solid #ddd;padding-left:8px;color:#555;\"/>\n"
"                            </details>\n"
"                        </div>\n"
"                    </li>\n"
"                </ul>\n"
"                <p>Regards,</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;\">\n"
"                <p>Bonjour,</p>\n"
"                <p>\n"
"                    La version\n"
"                    <strong t-out=\"object.version\"/>\n"
"                    de\n"
"                    <strong t-out=\"object.cross_connect_client_id.name\"/>\n"
"                    est désormais déployée en production. Elle contient les\n"
"                    tickets suivants :\n"
"                </p>\n"
"                <ul>\n"
"                    <li t-foreach=\"object.task_ids\" t-as=\"task\" style=\"margin-bottom:10px;\">\n"
"                        <a t-att-href=\"object._get_task_url(task)\" t-out=\"task.name\"/>\n"
"                        <div t-if=\"task.description\">\n"
"                            <details>\n"
"                                <summary style=\"cursor:pointer;color:#666;\">\n"
"                                    Description\n"
"                                </summary>\n"
"                                <div t-out=\"task.description\" style=\"border-left:3px solid #ddd;padding-left:8px;color:#555;\"/>\n"
"                            </details>\n"
"                        </div>\n"
"                    </li>\n"
"                </ul>\n"
"                <p>Cordialement,</p>\n"
"            </div>\n"
"        "

#. module: support_server_release
#: model:mail.template,name:support_server_release.mail_template_release_in_prod
msgid "Support Release: release in production"
msgstr "Support Release : version mise en production"

#. module: support_server_release
#: model:mail.template,subject:support_server_release.mail_template_release_in_prod
msgid ""
"{{ object.cross_connect_client_id.name }}: version {{ object.version }} in "
"production"
msgstr ""
"{{ object.cross_connect_client_id.name }} : version {{ object.version }} en "
"production"
