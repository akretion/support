<odoo>
    <record id="mail_template_release_in_prod" model="mail.template">
        <field name="name">Support Release: release in production</field>
        <field name="model_id" ref="model_support_server_release" />
        <field
            name="subject"
        >{{ object.cross_connect_client_id.name }}: version {{ object.version }} in production</field>
        <field name="email_to">{{ object._get_notification_emails() }}</field>
        <field name="auto_delete" eval="False" />
        <field name="body_html" type="html">
            <div
                style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;"
            >
                <p>Hello,</p>
                <p>
                    Version
                    <strong t-out="object.version" />
                    of
                    <strong t-out="object.cross_connect_client_id.name" />
                    is now deployed in production. It contains the following
                    tickets:
                </p>
                <ul>
                    <li
                        t-foreach="object.task_ids"
                        t-as="task"
                        style="margin-bottom:10px;"
                    >
                        <a t-att-href="object._get_task_url(task)" t-out="task.name" />
                        <div t-if="task.description">
                            <details>
                                <summary style="cursor:pointer;color:#666;">
                                    Description
                                </summary>
                                <div
                                    t-out="task.description"
                                    style="border-left:3px solid #ddd;padding-left:8px;color:#555;"
                                />
                            </details>
                        </div>
                    </li>
                </ul>
                <p>Regards,</p>
            </div>
        </field>
    </record>
</odoo>
